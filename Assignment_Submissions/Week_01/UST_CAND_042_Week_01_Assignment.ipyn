   "source": [
    "# ==============================================================================\n",
    "# SOLUTION CELL: Part 1 - Anthropic API Integration & Prompt Engineering\n",
    "# Candidate ID: UST-CAND-201806\n",
    "# ==============================================================================\n",
    "\n",
    "# Task 1.1: API call wrapper\n",
    "def call_anthropic_api(\n",
    "    user_prompt: str, \n",
    "    system_prompt: str = None, \n",
    "    model: str = None, \n",
    "    temperature: float = 0.2, \n",
    "    max_tokens: int = 300\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Invokes Anthropic Claude model and returns structured execution metadata.\n",
    "    \"\"\"\n",
    "    return resilient_anthropic_call(\n",
    "        prompt=user_prompt,\n",
    "        system=system_prompt,\n",
    "        temperature=temperature,\n",
    "        max_tokens=max_tokens,\n",
    "        model=model or model_name,\n",
    "    )\n",
    " \n",
    "\n",
    "# Task 1.2: structured extraction at low temperature and mitigation synthesis at high temperature\n",
    "ticket_prompt = \"\"\"Extract incident details from the unformatted ticket below. Return only one valid JSON object with exactly these keys: ticket_id, service, severity, issue, customer_impact, and reported_at. Use null for unstated fields.\n",
    "\n",
    "Ticket: INC-4821 was reported at 2026-11-17 09:20 UTC. The payments checkout API in production has intermittent 503 errors following the latest deployment. About 12% of checkout attempts fail. No data loss is known, and the on-call team is investigating.\"\"\"\n",
    "\n",
    "ticket_result = call_anthropic_api(\n",
    "    user_prompt=ticket_prompt,\n",
    "    system_prompt=\"Extract structured fields; avoid assumptions.\",\n",
    "    temperature=0.0,\n",
    "    max_tokens=300,\n",
    ")\n",
    "\n",
    "mitigation_prompt = \"\"\"For incident INC-4821, the production payments checkout API has intermittent 503 errors after a deployment, affecting about 12% of attempts. No data loss is known. Propose three distinct mitigation options for executives. For each, state the action, expected benefit, key risk, and a decision trigger. Do not claim any action has already been taken.\"\"\"\n",
    "mitigation_result = call_anthropic_api(\n",
    "    user_prompt=mitigation_prompt,\n",
    "    system_prompt=\"You are an executive incident-response advisor. Be concise and explicit about uncertainty.\",\n",
    "    temperature=0.8,\n",
    "    max_tokens=500,\n",
    ")\n",
    "\n",
    "print(\"Deterministic structured extraction (temperature=0.0):\")\n",
    "print(ticket_result[\"text\"])\n",
    "print(\"\\nCreative mitigation options (temperature=0.8):\")\n",
    "print(mitigation_result[\"text\"])\n",
    "print(\"\\nConsistency observation: temperature=0.0 favors repeatable, schema-focused wording;\")\n",
    "print(\"temperature=0.8 permits more varied phrasing and mitigation ideas. Higher temperature\")\n",
    "print(\"does not guarantee correctness, so validate the extracted fields and proposed actions.\")\n"
   ]
