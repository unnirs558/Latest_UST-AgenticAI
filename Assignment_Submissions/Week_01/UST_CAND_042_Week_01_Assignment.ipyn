   "source": [
    "## ⚙️ Environment Setup & API Pre-Flight\n",
    "In this assignment, you will connect to Anthropic frontier models (`claude-sonnet-4-6` or `claude-3-5-sonnet-20241022`) using the API key defined in your environment (`.env`).\n",
    "\n",
    "You can use either:\n",
    "1. The official `anthropic` Python SDK (`import anthropic; client = anthropic.Anthropic()`), OR\n",
    "2. The standard Python REST client (`urllib.request` / `requests`) sending direct POST requests to `https://api.anthropic.com/v1/messages`.\n",
    "\n",
    "Run the cell below to verify your `.env` configuration and API connectivity.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "0c1ffd2d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[*] Environment Verification:\n",
      "  - ANTHROPIC_API_KEY configured: True\n",
      "  - ANTHROPIC_MODEL target      : claude-sonnet-4-6\n",
      "[✓] Pre-flight helper loaded.\n"
     ]
    }
   ],
   "source": [
    "# Environment & Resilience Verification\n",
    "import os\n",
    "import json\n",
    "import base64\n",
    "import time\n",
    "import urllib.error\n",
    "import urllib.request\n",
    "from pathlib import Path\n",
    "\n",
    "# Load environment variables from .env\n",
    "env_paths = [Path(\".env\"), Path(\"../.env\"), Path(\"../../.env\"), Path(\"../../../.env\")]\n",
    "for p in env_paths:\n",
    "    if p.exists():\n",
    "        with open(p, \"r\", encoding=\"utf-8\") as f:\n",
    "            for line in f:\n",
    "                line = line.strip()\n",
    "                if line and not line.startswith(\"#\") and \"=\" in line:\n",
    "                    key_name, value = line.split(\"=\", 1)\n",
    "                    value = value.strip()\n",
    "                    if len(value) >= 2 and value[0] == value[-1] and value[0] in \"\\\"'\":\n",
    "                        value = value[1:-1]\n",
    "                    os.environ.setdefault(key_name.strip(), value)\n",
    "        break\n",
    "\n",
    "api_key = os.environ.get(\"ANTHROPIC_API_KEY\", \"\").strip()\n",
    "model_name = os.environ.get(\"ANTHROPIC_MODEL\", \"claude-sonnet-4-6\").strip()\n",
    "\n",
    "print(\"[*] Environment Verification:\")\n",
    "print(f\"  - ANTHROPIC_API_KEY configured: {bool(api_key)}\")\n",
    "print(f\"  - ANTHROPIC_MODEL target      : {model_name}\")\n",
    "\n",
    "def resilient_anthropic_call(prompt: str, system: str = None, temperature: float = 0.2, max_tokens: int = 300, model: str = None) -> dict:\n",
    "    \"\"\"Invoke Anthropic Messages API and return response text plus usage metadata.\"\"\"\n",
    "    if not api_key:\n",
    "        raise ValueError(\"ANTHROPIC_API_KEY not found in environment or .env file.\")\n",
    "    if not isinstance(prompt, str) or not prompt.strip():\n",
    "        raise ValueError(\"prompt must be a non-empty string.\")\n",
    "    if not 0.0 <= temperature <= 1.0:\n",
    "        raise ValueError(\"temperature must be between 0.0 and 1.0.\")\n",
    "    if not isinstance(max_tokens, int) or isinstance(max_tokens, bool) or max_tokens <= 0:\n",
    "        raise ValueError(\"max_tokens must be a positive integer.\")\n",
    "    \n",
    "    url = \"https://api.anthropic.com/v1/messages\"\n",
    "    headers = {\n",
    "        \"x-api-key\": api_key,\n",
    "        \"anthropic-version\": \"2023-06-01\",\n",
    "        \"content-type\": \"application/json\"\n",
    "    }\n",
    "    request_model = model or model_name\n",
    "    body = {\n",
    "        \"model\": request_model,\n",
    "        \"max_tokens\": max_tokens,\n",
    "        \"temperature\": temperature,\n",
    "        \"messages\": [{\"role\": \"user\", \"content\": prompt}]\n",
    "    }\n",
    "    if system:\n",
    "        body[\"system\"] = system\n",
    "\n",
    "    t0 = time.perf_counter()\n",
    "    req = urllib.request.Request(url, data=json.dumps(body).encode(\"utf-8\"), headers=headers)\n",
    "    try:\n",
    "        with urllib.request.urlopen(req, timeout=30) as resp:\n",
    "            res_data = json.loads(resp.read().decode(\"utf-8\"))\n",
    "    except urllib.error.HTTPError as error:\n",
    "        try:\n",
    "            error_data = json.loads(error.read().decode(\"utf-8\"))\n",
    "            error_message = error_data.get(\"error\", {}).get(\"message\", str(error))\n",
    "        except (json.JSONDecodeError, UnicodeDecodeError):\n",
    "            error_message = str(error)\n",
    "        raise RuntimeError(f\"Anthropic API returned HTTP {error.code}: {error_message}\") from error\n",
    "    latency = round((time.perf_counter() - t0) * 1000, 2)\n",
    "    text = \"\".join([b[\"text\"] for b in res_data.get(\"content\", []) if b.get(\"type\") == \"text\"])\n",
    "    usage = res_data.get(\"usage\", {})\n",
    "    return {\n",
    "        \"text\": text,\n",
    "        \"model\": res_data.get(\"model\", request_model),\n",
    "        \"tokens_used\": usage.get(\"input_tokens\", 0) + usage.get(\"output_tokens\", 0),\n",
    "        \"latency_ms\": latency,\n",
    "        \"status\": \"SUCCESS\"\n",
    "    }\n",
    "\n",
    "print(\"[✓] Pre-flight helper loaded.\")\n"
   ]
  },
  {
   "cell_type": "markdown",
